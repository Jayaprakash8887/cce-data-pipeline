# CCE Data Pipeline — Environment Variables
# Copy to .env and fill in actual values

# ClickHouse
CLICKHOUSE_PASSWORD=cce_analytics_dev

# PeerDB
PEERDB_CATALOG_PASSWORD=CHANGE_ME_IN_PRODUCTION

# PostgreSQL CDC
PG_HOST=cce-postgres
PG_PORT=5432
CDC_USER=cce_cdc_user
CDC_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ClickHouse Sink
CH_HOST=clickhouse
CH_PORT=8123
CH_USER=cce_pipeline
CH_PASSWORD=cce_analytics_dev

# Superset
SUPERSET_SECRET_KEY=cce-data-pipeline-dev-secret-key-change-in-prod
SUPERSET_DB_PASSWORD=superset_dev

# Grafana
GRAFANA_PASSWORD=admin

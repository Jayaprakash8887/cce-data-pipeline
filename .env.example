# CCE Data Pipeline — Environment Variables
# Copy to .env and fill in actual values

# ClickHouse
CLICKHOUSE_PASSWORD=cce_analytics_dev

# PeerDB nexus (SQL interface on port 9900)
# Password for connecting to the nexus via psql (used by the connector scripts).
PEERDB_PASSWORD=peerdb
# Secret for the PeerDB web UI session (NextAuth). Change for any shared/prod host.
PEERDB_UI_NEXTAUTH_SECRET=__changeme__

# MinIO — mandatory S3 staging for PeerDB → ClickHouse (Avro stage).
# These are the object-store credentials AND the PeerDB ClickHouse staging creds.
# To use AWS S3 instead: leave MinIO out, set AWS_* below and unset the
# minio:9000 endpoint in docker-compose.yml's x-peerdb-flow-env.
MINIO_ROOT_USER=cce_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION
MINIO_BUCKET=peerdbbucket

# AWS S3 (only if using AWS instead of MinIO; leave blank for MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT=

# PostgreSQL CDC source (the EXISTING ccedb — NOT part of this compose stack)
# Consumed by scripts/create-peers.sh (ccedb_peer) and cdc/01-configure-replication.sql
PG_HOST=cce-postgres
PG_PORT=5432
PG_DATABASE=ccedb
CDC_USER=cce_cdc_user
CDC_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ClickHouse destination (consumed by scripts/create-peers.sh → clickhouse_peer)
# CH_PORT = HTTP (8123, clients); CH_NATIVE_PORT = native protocol (9000, the PeerDB peer)
CH_HOST=clickhouse
CH_PORT=8123
CH_NATIVE_PORT=9000
CH_DATABASE=cce_analytics
CH_USER=cce_pipeline
CH_PASSWORD=cce_analytics_dev

# Grafana (host port 3001 — PeerDB UI owns 3000)
GRAFANA_PASSWORD=admin

# Presentation layer (cce-insights-service / cce-insights-ui) is a separate deployment.
# It connects to ClickHouse using the cce_pipeline user above (HTTP 8123 or native 9000).
